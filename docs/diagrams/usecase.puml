@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam ArrowColor #333333
left to right direction
skinparam usecase {
  BackgroundColor #ECE9FB
  BorderColor #7C6BC4
}
skinparam actor {
  BackgroundColor #ECE9FB
  BorderColor #7C6BC4
}

actor "Cabin Owner" as owner
actor "Administrator" as admin
actor "Notification\nService" as notif

rectangle "Hytte Monitoring System" {
  usecase "Authenticate" as UC0
  usecase "View current status" as UC1
  usecase "View historical trends" as UC2
  usecase "Configure alert\nthresholds" as UC3
  usecase "Manage sensors\n/ devices" as UC4
  usecase "Receive alert" as UC5
  usecase "Acknowledge alert" as UC6
}

owner --> UC1
owner --> UC2
owner --> UC3
owner --> UC5
owner --> UC6
admin --> UC4
admin --> UC3
UC5 --> notif

UC1 ..> UC0 : <<include>>
UC2 ..> UC0 : <<include>>
UC3 ..> UC0 : <<include>>
UC4 ..> UC0 : <<include>>
UC6 ..> UC5 : <<extend>>
@enduml
